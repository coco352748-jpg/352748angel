{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rq-vedic:schema:execution:v1",
  "title": "RQ Vedic Execution and Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "execution_hash",
    "target_lock",
    "source_snapshot",
    "selected_level",
    "selected_action",
    "selected_d_chart",
    "selected_house",
    "selected_modules",
    "method_bindings",
    "layer_packets",
    "operator_results",
    "admitted_claims",
    "filtered_claims",
    "holds",
    "conflicts",
    "final_claims",
    "qa",
    "state"
  ],
  "properties": {
    "execution_id": {"type": "string", "minLength": 1},
    "execution_hash": {"type": "string", "minLength": 16},
    "target_lock": {"type": "object"},
    "source_snapshot": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "selected_level": {"enum": ["ELIVEDIC", "ELICOLLEGE", "ELIPHD"]},
    "selected_action": {"enum": ["RULE_BUILD", "RULE_QUERY", "CHART_EXECUTE", "AUDIT"]},
    "selected_d_chart": {"type": ["string", "null"]},
    "selected_house": {"type": ["string", "null"]},
    "selected_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "method_bindings": {"type": "array", "items": {"type": "object"}},
    "layer_packets": {"type": "array", "items": {"type": "object"}},
    "operator_results": {"type": "object"},
    "admitted_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "filtered_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "holds": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "final_claims": {"type": "array", "items": {"type": "object"}},
    "qa": {"type": "object"},
    "state": {"enum": ["IN_PROGRESS", "PASS", "REVISE", "HOLD", "CONFLICT"]}
  }
}
