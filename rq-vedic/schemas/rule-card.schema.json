{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rq-vedic:schema:rule-card:v1",
  "title": "RQ Vedic Rule Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "version",
    "canonical_claim",
    "source_claim_refs",
    "source_family_refs",
    "method_id",
    "applicable_d_charts",
    "applicable_houses",
    "applicable_modules",
    "required_inputs",
    "calculation_settings",
    "exceptions",
    "falsifiers",
    "admission_grade",
    "evidence_authority",
    "state"
  ],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "canonical_claim": {"type": "string", "minLength": 1},
    "source_claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_family_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "method_id": {"type": "string", "minLength": 1},
    "applicable_d_charts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "applicable_houses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "applicable_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "calculation_settings": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "items": {"type": "string"}},
    "admission_grade": {
      "enum": [
        "CURRENT_COMMON_CORE",
        "METHOD_SPECIFIC",
        "POST_CHART_SCHOLAR",
        "HISTORICAL_SUPPORT",
        "HOLD"
      ]
    },
    "evidence_authority": {
      "enum": [
        "DIRECT_SOURCE",
        "DERIVED",
        "REFERENCE",
        "USER_SPECIFIED",
        "INFERENCE",
        "WORKING_ASSUMPTION"
      ]
    },
    "case_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "counterexample_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "state": {
      "enum": [
        "RAW_CLAIM",
        "PARSED_CLAIM",
        "RULE_CANDIDATE",
        "METHOD_BOUND",
        "EVIDENCE_REVIEWED",
        "CASE_TESTED",
        "ACTIVE_RULE",
        "HOLD",
        "CONFLICT",
        "REJECTED",
        "VOID",
        "SUPERSEDED"
      ]
    }
  }
}
